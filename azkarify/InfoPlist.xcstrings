    "NSLocationWhenInUseUsageDescription": {
      "comment": "Why the app requests a one-time location for local prayer calculations",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your location to calculate prayer times on this device. Your coordinates are not sent to our servers."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم موقعك لحساب مواقيت الصلاة على هذا الجهاز. لا تُرسل إحداثياتك إلى خوادمنا."
          }
        }
      }
    }
